{
  "name": "casalenaa",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "description": "Sistema POS Casalena",
  "author": "Casalena",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron:dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "electron:build": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --win && node -e \"require('fs').copyFileSync('dist/CasalenaPOS.exe', 'public/CasalenaPOS.exe')\""
  },
  "build": {
    "appId": "com.casalena.pos",
    "productName": "Casalena POS",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "luigi123-bot",
        "repo": "casalenaaaa"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/icon.png",
      "artifactName": "CasalenaPOS.exe",
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "electron/**/*",
      "app/icon.png",
      "package.json"
    ]
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google/generative-ai": "^0.24.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/realtime-js": "^2.93.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.2",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^8.0.0",
    "dompurify": "^3.4.5",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.1.0",
    "leaflet": "^1.9.4",
    "material-symbols": "^0.43.0",
    "next": "16.1.5",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.5",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  }
}
